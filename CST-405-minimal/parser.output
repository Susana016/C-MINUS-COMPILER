   76         | FOR LPAREN ID '=' expr ';' expr ';' ID '=' expr RPAREN . stmt
   77 if_stmt: . IF LPAREN expr RPAREN stmt
   78        | . IF LPAREN expr RPAREN stmt ELSE stmt
   79 switch_stmt: . SWITCH LPAREN expr RPAREN LBRACE case_list RBRACE

    ID      shift, and go to state 94
    INT     shift, and go to state 95
    DOUBLE  shift, and go to state 96
    PRINT   shift, and go to state 97
    WHILE   shift, and go to state 98
    FOR     shift, and go to state 99
    IF      shift, and go to state 100
    RETURN  shift, and go to state 101
    LBRACE  shift, and go to state 65
    SWITCH  shift, and go to state 103
    BREAK   shift, and go to state 104

    block        go to state 105
    stmt         go to state 210
    decl         go to state 108
    assign       go to state 109
    print_stmt   go to state 110
    while_stmt   go to state 111
    for_stmt     go to state 112
    if_stmt      go to state 113
    switch_stmt  go to state 114


state 210

   76 for_stmt: FOR LPAREN ID '=' expr ';' expr ';' ID '=' expr RPAREN stmt .

    $default  reduce using rule 76 (for_stmt)
