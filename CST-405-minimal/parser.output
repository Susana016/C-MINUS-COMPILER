Grammar

    0 $accept: program $end

    1 program: top_level_list

    2 top_level_list: top_level_item
    3               | top_level_list top_level_item

    4 top_level_item: global_decl
    5               | function_decl

    6 global_decl: INT ID ';'
    7            | DOUBLE ID ';'
    8            | INT ID '=' expr ';'
    9            | INT ID LBRACKET NUM RBRACKET ';'
   10            | INT ID LBRACKET NUM RBRACKET LBRACKET NUM RBRACKET ';'

   11 function_decl: INT ID LPAREN param_list RPAREN block
   12              | VOID ID LPAREN param_list RPAREN block
   13              | INT MAIN LPAREN RPAREN block
   14              | VOID MAIN LPAREN RPAREN block

   15 block: LBRACE stmt_list RBRACE
   16      | LBRACE RBRACE

   17 param_list: /* empty */
   18           | non_empty_param_list

   19 non_empty_param_list: param
   20                     | non_empty_param_list COMMA param

   21 param: INT ID
   22      | DOUBLE ID
   23      | INT ID LBRACKET RBRACKET
   24      | DOUBLE ID LBRACKET RBRACKET

   25 stmt_list: stmt
   26          | stmt_list stmt

   27 stmt: decl
   28     | assign
   29     | print_stmt
   30     | while_stmt
   31     | for_stmt
   32     | if_stmt
   33     | switch_stmt
   34     | block
   35     | BREAK ';'
   36     | RETURN expr ';'
   37     | RETURN ';'
   38     | ID LPAREN expr RPAREN ';'
   39     | ID LPAREN RPAREN ';'

   40 decl: INT ID ';'
   41     | DOUBLE ID ';'
   42     | INT ID '=' expr ';'
   43     | INT ID LBRACKET NUM RBRACKET ';'
   44     | INT ID LBRACKET NUM RBRACKET LBRACKET NUM RBRACKET ';'

   45 assign: ID '=' expr ';'
   46       | ID LBRACKET expr RBRACKET '=' expr ';'
   47       | ID LBRACKET expr RBRACKET LBRACKET expr RBRACKET '=' expr ';'

   48 expr: NUM
   49     | FLOAT_NUM
   50     | ID
   51     | expr '+' expr
   52     | expr '-' expr
   53     | expr '*' expr
   54     | expr '/' expr
   55     | expr '%' expr
